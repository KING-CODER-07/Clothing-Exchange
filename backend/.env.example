# ==========================================
# Clothing Exchange & Swap - Backend Config
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/clothing-swap
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/clothing-swap?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/clothing-swap

# JSON Web Token Secret (generate a strong 64-character random string for production)
JWT_SECRET=swap-marketplace-super-secret-key-change-in-production

# Allowed Frontend Origins for CORS (comma separated in production)
# Example: https://clothing-exchange.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,http://localhost:3000
